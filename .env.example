# ---------- Next.js (copy to .env.local) ----------
# Clerk: dashboard.clerk.com -> your application -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Convex: printed by `npx convex dev` (also written to .env.local automatically)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Convex HTTP actions live on the .site domain; used by the n8n container (see n8n/.env.example)
# https://your-deployment.convex.site

# ---------- Convex deployment env (set with `npx convex env set NAME value`) ----------
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev   (Clerk -> JWT templates -> "convex" -> Issuer)
# N8N_WEBHOOK_URL=https://<public-tunnel-host>/webhook/lendloop/loan-events
# N8N_WEBHOOK_SECRET=<long random string>        (Convex -> n8n; must equal the value on the n8n container)
# AUTOMATION_API_SECRET=<another long random>    (n8n -> Convex; must equal the value on the n8n container)
# NOTIFY_INCLUDE_EMAIL=false                     (leave unset to keep emails out of webhooks and n8n)
