# Copy to n8n/.env  (docker compose reads it). Never commit the real file.

# Convex -> n8n signature secret. Must equal N8N_WEBHOOK_SECRET in the Convex deployment.
N8N_WEBHOOK_SECRET=change-me-long-random
# n8n -> Convex signature secret. Must equal AUTOMATION_API_SECRET in the Convex deployment.
AUTOMATION_API_SECRET=change-me-another-long-random

# Your Convex HTTP actions domain (note: .site, not .cloud)
CONVEX_SITE_URL=https://your-deployment.convex.site

# Encrypts n8n's own credential store. Generate with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me-hex

# Public URL of n8n as Convex sees it (tunnel host). Used by n8n to build webhook URLs.
WEBHOOK_URL=http://localhost:5678/

# Optional: also post every notification to a Slack/Mattermost-compatible incoming webhook.
NOTIFY_WEBHOOK_URL=

GENERIC_TIMEZONE=Asia/Almaty
